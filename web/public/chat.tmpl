<script src="https://cdn.tailwindcss.com"></script>

<div class="h-screen bg-slate-950 text-white flex overflow-hidden">

    <!-- LEFT SIDE -->
    <div class="w-80 border-r border-slate-800 p-4 space-y-5">

        <div>
            <h1 class="text-2xl font-bold">Triad Chat</h1>
            <p id="status" class="text-sm text-red-400">Disconnected</p>

            <button onclick="connect()"
                class="mt-3 w-full bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded">
                Connect
            </button>
        </div>

        <div class="space-y-2">
            <h2 class="font-semibold">Create room</h2>

            <input id="createRoomName"
                class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2"
                placeholder="Room name">

            <input id="createRoomType"
                class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2"
                placeholder="Room type">

            <button onclick="createRoom()"
                class="w-full bg-green-600 hover:bg-green-700 px-4 py-2 rounded">
                Create
            </button>
        </div>

        <div class="space-y-2">
            <h2 class="font-semibold">Search rooms</h2>

            <input id="searchRoomInput"
                class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-2"
                placeholder="Room name">

            <button onclick="searchRooms()"
                class="w-full bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded">
                Search
            </button>
        </div>

        <div id="rooms" class="space-y-3"></div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="flex-1 flex flex-col h-full">

        <div class="h-16 border-b border-slate-800 px-6 flex items-center">
            <div>
                <h2 id="roomTitle" class="font-bold text-lg">No room selected</h2>
                <p id="roomInfo" class="text-sm text-slate-400">Connect and join a room</p>
            </div>
        </div>

        <div id="messages"
            class="flex-1 overflow-y-auto p-6 space-y-3 bg-slate-900">
        </div>

        <div class="border-t border-slate-800 p-4 flex gap-3">
            <input id="message"
                class="flex-1 bg-slate-900 border border-slate-700 rounded px-4 py-3"
                placeholder="Message..."
                onkeypress="if(event.key === 'Enter') sendMessage()">

            <button onclick="sendMessage()"
                class="bg-blue-600 hover:bg-blue-700 px-6 rounded">
                Send
            </button>
        </div>

    </div>
</div>

<script>
let ws = null;
let roomID = null;
let roomName = null;
let cursor = null;
let loadingOldMessages = false;

const messagesDiv = document.getElementById("messages");

function connect() {
    if (ws && ws.readyState === WebSocket.OPEN) {
        console.log("websocket already open");
        return;
    }

    if (ws && ws.readyState === WebSocket.CONNECTING) {
        console.log("websocket is still connecting");
        return;
    }

    if (ws && ws.readyState === WebSocket.CLOSING) {
        console.log("old websocket is closing, resetting local reference");
        ws = null;
    }

    ws = new WebSocket("ws://localhost:8080/ws");

    ws.onopen = function() {
        document.getElementById("status").textContent = "Connected";
        document.getElementById("status").className = "text-sm text-green-400";
    };

    ws.onclose = function(e) {
        console.log("websocket closed:", e.code, e.reason);

        document.getElementById("status").textContent = "Disconnected";
        document.getElementById("status").className = "text-sm text-red-400";

        ws = null;
        roomID = null;
        roomName = null;
        cursor = null;
        loadingOldMessages = false;
    };

    ws.onerror = function(e) {
        console.log("websocket error:", e);

        if (ws) {
            ws.close();
        }
    };

    ws.onmessage = function(event) {
        const payloads = String(event.data)
            .split("\n")
            .map(chunk => chunk.trim())
            .filter(Boolean);

        payloads.forEach(payload => {
            let msg;

            try {
                msg = JSON.parse(payload);
            } catch (err) {
                console.log("could not parse websocket payload:", payload, err);
                return;
            }

            if (msg.type === "join_room" || msg.type === "leave_room") {
                addSystemMessage(msg.content);
                return;
            }

            addMessage(msg, false);
            scrollBottom();
        });
    };
}

async function createRoom() {
    const name = document.getElementById("createRoomName").value.trim();
    const type = document.getElementById("createRoomType").value.trim();

    if (!name || !type) {
        alert("Room name and type required");
        return;
    }

    const res = await fetch("/chat/createRoom", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            name: name,
            type: type
        })
    });

    if (!res.ok) {
        alert("Could not create room");
        return;
    }

    document.getElementById("createRoomName").value = "";
    document.getElementById("createRoomType").value = "";

    alert("Room created");
}

async function searchRooms() {
    const name = document.getElementById("searchRoomInput").value.trim();

    const res = await fetch("/chat/search", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            name: name
        })
    });

    if (!res.ok) {
        alert("Could not search rooms");
        return;
    }

    const convos = await res.json();
    const roomsDiv = document.getElementById("rooms");

    roomsDiv.innerHTML = "";

    if (!convos || convos.length === 0) {
        roomsDiv.innerHTML = `<p class="text-slate-500 text-sm">No rooms found</p>`;
        return;
    }

    convos.forEach(convo => {
        const div = document.createElement("div");
        div.className = "bg-slate-900 border border-slate-700 rounded p-3";

        div.innerHTML = `
            <p class="font-semibold">${escapeHTML(convo.name)}</p>
            <p class="text-sm text-slate-400">Type: ${escapeHTML(convo.type)}</p>
            <p class="text-xs text-slate-500">ID: ${convo.id}</p>
            <button class="mt-2 w-full bg-blue-600 hover:bg-blue-700 rounded px-3 py-2">
                Join
            </button>
        `;

        div.querySelector("button").addEventListener("click", function() {
            joinExistingRoom(convo.id, convo.name);
        });

        roomsDiv.appendChild(div);
    });
}

async function joinExistingRoom(id, name) {
    if (!ws || ws.readyState !== WebSocket.OPEN) {
        alert("Connect first");
        return;
    }

    roomID = id;
    roomName = name;
    cursor = null;
    hasMoreMessages = true;
    loadingOldMessages = false;

    document.getElementById("roomTitle").textContent = roomName;
    document.getElementById("roomInfo").textContent = "Room ID: " + roomID;

    messagesDiv.innerHTML = "";

    await loadInitialMessages(roomID);

    ws.send(JSON.stringify({
        type: "join_room",
        room_id: roomID.toString()
    }));
}

async function loadInitialMessages(convoID) {
    const res = await fetch(`/chat/messages?convoID=${convoID}`);

    if (!res.ok) {
        console.log("could not load initial messages");
        return;
    }

    const data = await res.json();

    if (data.messages) {
        data.messages.forEach(msg => {
            addMessage(msg, false);
        });
    }

    cursor = data.cursor;
    scrollBottom();
}

let hasMoreMessages = true;

async function loadOlderMessages() {
    if (!roomID || cursor === null || loadingOldMessages || !hasMoreMessages) return;

    loadingOldMessages = true;

    const oldHeight = messagesDiv.scrollHeight;

    try {
        const res = await fetch(`/chat/messages?convoID=${roomID}&cursor=${cursor}`);

        if (!res.ok) {
            console.log("could not load older messages");
            return;
        }

        const data = await res.json();

        if (!data.messages || data.messages.length === 0) {
            hasMoreMessages = false;
            return;
        }

        for (let i = data.messages.length - 1; i >= 0; i--) {
            addMessage(data.messages[i], true);
        }

        cursor = data.cursor;

        requestAnimationFrame(() => {
            const newHeight = messagesDiv.scrollHeight;
            messagesDiv.scrollTop = newHeight - oldHeight;
        });

    } finally {
        loadingOldMessages = false;
    }
}

function sendMessage() {
    if (!ws || ws.readyState !== WebSocket.OPEN) {
        alert("Connect first");
        return;
    }

    if (!roomID) {
        alert("Join room first");
        return;
    }

    const input = document.getElementById("message");
    const content = input.value.trim();

    if (!content) return;

    ws.send(JSON.stringify({
        type: "message",
        room_id: roomID.toString(),
        content: content
    }));

    input.value = "";
}

function addMessage(msg, prepend) {
    const username = msg.username || msg.Username || "unknown";
    const content = msg.content || msg.Content || "";

    const div = document.createElement("div");
    div.className = "bg-slate-800 rounded-lg px-4 py-2 max-w-xl";

    const user = document.createElement("div");
    user.className = "text-xs text-blue-400 font-semibold";
    user.textContent = username;

    const text = document.createElement("div");
    text.className = "text-sm whitespace-pre-wrap break-words";
    text.textContent = content;

    div.appendChild(user);
    div.appendChild(text);

    if (prepend) {
        messagesDiv.prepend(div);
    } else {
        messagesDiv.appendChild(div);
    }
}

function addSystemMessage(content) {
    const div = document.createElement("div");
    div.className = "text-center text-xs text-slate-500";
    div.textContent = content;

    messagesDiv.appendChild(div);
    scrollBottom();
}

function scrollBottom() {
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
}

messagesDiv.addEventListener("scroll", function() {
    if (messagesDiv.scrollTop <= 10) {
        loadOlderMessages();
    }
});

function escapeHTML(value) {
    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}
</script>

